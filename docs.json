  "description": "Strautomator documentation and support center.",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "decoration": "gradient"
  },
  "metadata": {
    "timestamp": false
  },
  "markdown": {
    "schema": true
  }
