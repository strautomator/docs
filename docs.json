            "pages": [
              "automations/overview",
              "automations/conditions",
              "automations/actions",
              "automations/dynamic-tags",
              "automations/sharing",
              "automations/history"
            ]
          },
          {
            "group": "Gear Tracking",
            "pages": [
              "gear/overview",
              "gear/components",
              "gear/battery-tracker"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/calendar",
              "features/upcoming-events-map",
              "features/personal-records",
              "features/ftp-estimator",
              "features/ai-content",
              "features/activity-debug"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/garmin-wahoo",
              "integrations/spotify-lastfm",
              "integrations/weather",
              "integrations/webhooks"
            ]
          },
          {
            "group": "Account & Billing",
            "pages": [
              "account/settings",
              "account/notifications",
              "account/data-export",
              "account/billing",
              "account/close-account"
            ]
          }
        ]
      },
      {
        "tab": "FAQ",
        "groups": [
